; ==================================================================
;  pong.xlas — PONG для XLA VM v0.12 (по мотивам встроенного).
;  Игрок (низ) против CPU (верх), мяч, счёт до 5.
;  Управление: стик влево/вправо, выход — удержание.
; ==================================================================
.title PONG
.data 16
; g0=px(игрок) g1=cx(cpu) g2=bx g3=by g4=vx g5=vy g6=plScore g7=cpuScore
; g8=lastT g9=winner(0 нет,1 пл,2 цп) g10=tmp
.str s_pl P
.str s_cp C
.str s_win WIN!
.str s_key best

start:
    push 57
    gstore 0          ; px игрок (центр)
    push 57
    gstore 1          ; cx cpu
    push 64
    gstore 2          ; bx
    push 32
    gstore 3          ; by
    push 1
    gstore 4          ; vx
    push 1
    gstore 5          ; vy
    push 0
    gstore 6
    push 0
    gstore 7
    msec
    gstore 8

main:
    frame

    event
    dup
    push 6
    eq
    jnz do_exit
    drop

    ; победитель? OK = рестарт
    gload 9
    jnz win_chk
    jmp play
win_chk:
    event
    dup
    push 5
    eq
    jnz do_restart
    drop
    jmp draw

play:
    ; ---- игрок: стик влево/вправо ----
    stick
    dup
    push 6
    eq
    jnz pl_left
    dup
    push 2
    eq
    jnz pl_right
    drop
    jmp cpu

pl_left:
    drop
    gload 0
    push 10
    gt
    jnz pl_left_ok
    jmp cpu
pl_left_ok:
    gload 0
    push 4
    sub
    gstore 0
    jmp cpu

pl_right:
    drop
    gload 0
    push 108
    lt
    jnz pl_right_ok
    jmp cpu
pl_right_ok:
    gload 0
    push 4
    add
    gstore 0
    jmp cpu

cpu:
    ; ---- CPU следует за мячом (медленно) ----
    gload 2
    gload 1
    push 10
    add
    lt
    jnz cpu_left
    gload 2
    gload 1
    push 10
    add
    gt
    jnz cpu_right
    jmp ball

cpu_left:
    gload 1
    push 2
    sub
    gstore 1
    jmp ball
cpu_right:
    gload 1
    push 2
    add
    gstore 1
    jmp ball

ball:
    ; ---- мяч: шаг каждые 40 мс ----
    msec
    gload 8
    sub
    push 40
    ge
    jnz ball_go
    jmp draw
ball_go:
    msec
    gstore 8
    gload 2
    gload 4
    add
    gstore 2          ; bx += vx
    gload 3
    gload 5
    add
    gstore 3          ; by += vy

    ; стены
    gload 2
    push 3
    lt
    jnz bounce_x
    gload 2
    push 124
    gt
    jnz bounce_x
    jmp chk_pl

bounce_x:
    gload 4
    neg
    gstore 4
    beep 700 12
    jmp chk_pl

chk_pl:
    ; ракетка игрока (y=57..60, |bx-px|<12)?
    gload 3
    push 55
    ge
    gload 3
    push 61
    le
    and
    jnz chk_pl2
    jmp chk_pl_miss
chk_pl2:
    gload 2
    gload 0
    push 12
    add
    lt
    gload 2
    gload 0
    push 12
    sub
    gt
    and
    jnz pl_hit
    jmp chk_pl_miss

pl_hit:
    push -1
    gstore 5          ; vy вверх
    ; угол от позиции
    gload 2
    gload 0
    sub
    push 4
    div
    gstore 4          ; vx = (bx-px)/4
    beep 1000 15
    jmp cpu_chk

chk_pl_miss:
    gload 3
    push 63
    gt
    jnz pl_lose
    jmp cpu_chk

pl_lose:
    gload 7
    push 1
    add
    gstore 7          ; cpuScore++
    beep 300 100
    ; сброс мяча
    push 64
    gstore 2
    push 32
    gstore 3
    push 1
    gstore 4
    push 1
    gstore 5
    ; победа cpu?
    gload 7
    push 5
    eq
    jnz set_cpu_win
    jmp cpu_chk

set_cpu_win:
    push 2
    gstore 9
    jmp cpu_chk

cpu_chk:
    ; ракетка cpu (y=3..6)?
    gload 3
    push 1
    ge
    gload 3
    push 7
    le
    and
    jnz cpu_chk2
    jmp chk_cpu_miss
cpu_chk2:
    gload 2
    gload 1
    push 12
    add
    lt
    gload 2
    gload 1
    push 12
    sub
    gt
    and
    jnz cpu_hit
    jmp chk_cpu_miss

cpu_hit:
    push 1
    gstore 5          ; vy вниз
    gload 2
    gload 1
    sub
    push 4
    div
    gstore 4
    beep 1000 15
    jmp draw

chk_cpu_miss:
    gload 3
    push 0
    lt
    jnz cpu_lose
    jmp draw

cpu_lose:
    gload 6
    push 1
    add
    gstore 6          ; plScore++
    beep 1400 60
    push 64
    gstore 2
    push 32
    gstore 3
    push 1
    gstore 4
    push -1
    gstore 5
    gload 6
    push 5
    eq
    jnz set_pl_win
    jmp draw

set_pl_win:
    push 1
    gstore 9
    jmp draw

do_restart:
    drop
    push 0
    gstore 6
    push 0
    gstore 7
    push 0
    gstore 9
    push 64
    gstore 2
    push 32
    gstore 3
    push 1
    gstore 4
    push 1
    gstore 5
    jmp draw

do_exit:
    gload 6
    gload 7
    gt
    jnz save_hi
    exit
save_hi:
    gload 6
    save s_key
    exit

; ---- отрисовка ----
draw:
    cls
    ; cpu ракетка
    gload 1
    push 3
    frect 12 1 1
    ; игрок
    gload 0
    push 57
    frect 12 3 1
    ; мяч
    gload 2
    gload 3
    frect 3 3 1
    ; счёт
    text 8 30 1 s_pl
    gload 6
    num 20 30 1
    text 100 30 1 s_cp
    gload 7
    num 112 30 1
    ; победа
    gload 9
    jz no_win
    text 52 40 1 s_win
no_win:
    disp
    jmp main
