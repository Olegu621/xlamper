; ==================================================================
; ROOT BEAR v2 — идеальный порт Playdate-игры для C3 XLAMPER
; Оригинал: Root Bear by TEAM ROOT (alexsussy.itch.io/root-bear)
; Спрайты медведей: 1:1 из оригинального .pdx (конвертация .pdi)
;
; МЕХАНИКА (как в оригинале, адаптация crank -> стик):
;   Стик вниз  = кран открыт. Чуть наклонил = медленный поток,
;   до упора вниз = мощный поток (риск перелить).
;   Отпустил стик = кран закрыт -> порция засчитана (оценка).
;   Пена: наливается с пивом, ОСЕДАЕТ после закрытия крана:
;   уровень окажется НИЖЕ чем видно — учитывай пену (как в оригинале!)
;   Отметка на стакане: dotted line = желаемый уровень.
;   Оценка: PERFECT +$8 (точно), GOOD +$4, MEH +$1, SPILL $0 (rage).
;   Таймер 60с жёсткий. Бесконечные клиенты, рекорд в NVS.
; ==================================================================
.title ROOTBEAR
.data 40
; g0 fill      уровень пива 0..100 (внутренняя шкала стакана)
; g1 foam      пена 0..100 (пена оседает! уровень = fill + foam/4)
; g2 flow      текущий поток 0..100 (0 = кран закрыт)
; g3 money     заработано $
; g4 timeLeft  сотые доли секунды (6000 = 60с)
; g5 state     0=serve 1=poured(оценка показана) 2=gameover
; g6 target    целевой уровень 25..95
; g7 glass     тип стакана 0..3 (влияет на скорость налива)
; g8 t         анимация
; g9 grade     0 none,1 perfect,2 good,3 meh,4 spill
; g10 gradT    таймер показа оценки (кадры)
; g11 bearAnim фаза медведя 0 neutral,1 blink,2 nervous1,3 nervous2
; g12 bearT    таймер анимации медведя
; g13 pours    счётчик порций
; g14 foamR    аккумулятор роста пены

.str S1 ROOT BEAR
.str S2 TIP JAR
.str S3 POUR!
.str S4 PERFECT
.str S5 GOOD
.str S6 MEH
.str S7 RAGE!
.str S8 SPILL!
.str S9 NEW BEST!
.str SA HOLD=EXIT
.str SB STICK DOWN TO POUR
.str K1 best
.str K2 pours

; стек: [exp] event -> 0 none,1..5 dirs/click,6 exit
; ================= init =================
start:
    push 3600
    gstore 4
    push 0
    gstore 3
    push 0
    gstore 13
    load K1 0
    gstore 15
    call new_order

; ================= main loop =================
main:
    frame
    ; ---- таймер: НЕПРЕРЫВНЫЙ (как в оригинале: 60с на всё) ----
    gload 4
    push 1
    sub
    dup
    push 0
    ge
    jnz mn_t_ok
    drop
    push 0
mn_t_ok:
    gstore 4
    gload 4
    push 0
    eq
    jnz mn_time_up
    jmp mn_grade_or_event
mn_time_up:
    gload 5
    push 2
    eq
    jnz mn_go_hold          ; уже game over: не спамить, просто кадр
    push 2
    gstore 5
    push 0
    gstore 10               ; сброс градT (оценка прерывается таймаутом)
    call game_over
    jmp main
mn_go_hold:
    call face_tick
    jmp draw
mn_grade_or_event:
    ; в poured: таймер оценки, потом новый заказ
    gload 5
    jnz mn_grade_tick
    jmp mn_event
mn_grade_tick:
    gload 10
    push 1
    sub
    dup
    push 0
    ge
    jnz mn_gt_ok
    drop
    push 0
mn_gt_ok:
    gstore 10
    gload 10
    jz main_g0
    jmp mn_event
main_g0:
    call new_order
mn_event:
    event
    dup
    push 6
    eq
    jnz ev_exit
    drop
    ; ---- стик: налив ----
    gload 5
    jnz ev_after_pour     ; в poured стик игнорируется
    sty
    push 2300
    sub                  ; 0..1795
    dup
    push 0
    le
    jnz flow_zero
    push 18
    div                  ; 0..99
    dup
    push 0
    gt
    jnz flow_ok
    drop
    push 0
flow_ok:
    gstore 2
    jmp ev_pour
flow_zero:
    drop
    ; стик отпущен: если лили — оценка
    gload 2
    jnz ev_serve
    push 0
    gstore 2
    jmp ev_after_pour
ev_pour:
    call pour_frame
    jmp ev_after_pour
ev_serve:
    push 0
    gstore 2
    call settle_and_grade
    jmp ev_after_pour
ev_after_pour:
    call face_tick
    jmp draw

ev_exit:
    drop
    exit

; ================= налив (один кадр) =================
pour_frame:
    ; поток в шкалу стакана: скорость зависит от типа стакана
    gload 2
    gload 7
    push 2
    mul
    push 10
    add             ; /10 /12 /14 /16 по типу (0..3): МЕДЛЕННЫЙ контролируемый налив
    div             ; flow / (10+glass*2)
    gload 0
    add
    push 100
    min
    gstore 0
    ; пена: растёт от потока (сильный поток = пена быстро)
    gload 2
    push 8
    div
    gload 14
    add
    gstore 14
    gload 14
    push 3
    ge
    jnz pf_foam_up
    ret
pf_foam_up:
    push 0
    gstore 14
    gload 1
    push 1
    add
    push 60
    min
    gstore 1
    ret

; ================= стик отпущен: пена осела -> оценка =================
settle_and_grade:
    ; пена оседает: уровень = fill + foam/4 (пена опадает, пиво остаётся)
    gload 0
    gload 1
    push 4
    div
    add
    gstore 16        ; eff уровень
    gload 16
    gload 6
    sub
    ; abs
    dup
    push 0
    lt
    jnz sg_neg
    jmp sg_pos
sg_neg:
    push -1
    mul
sg_pos:
    gstore 16        ; diff
    ; перелив: fill+foam > 100
    gload 0
    gload 1
    add
    push 100
    gt
    jnz sg_spill
    ; perfect: diff <= 4
    gload 16
    push 4
    le
    jnz sg_perfect
    ; good: diff <= 12
    gload 16
    push 12
    le
    jnz sg_good
    ; meh: diff <= 30
    gload 16
    push 30
    le
    jnz sg_meh
    ; почти пусто/мимо: $1
    jmp sg_bad
sg_perfect:
    push 1
    gstore 9
    push 8
    gstore 17
    gload 3
    push 8
    add
    gstore 3
    beep 1600 60
    beep 1900 90
    jmp sg_done
sg_good:
    push 2
    gstore 9
    push 4
    gstore 17
    gload 3
    push 4
    add
    gstore 3
    beep 1200 80
    jmp sg_done
sg_meh:
    push 3
    gstore 9
    push 1
    gstore 17
    gload 3
    push 1
    add
    gstore 3
    beep 700 120
    jmp sg_done
sg_bad:
    push 3
    gstore 9
    push 1
    gstore 17
    gload 3
    push 1
    add
    gstore 3
    beep 500 120
    jmp sg_done
sg_spill:
    push 4
    gstore 9
    push 0
    gstore 17
    beep 300 150
    beep 200 250
    jmp sg_done
sg_done:
    push 1
    gstore 5
    push 45
    gstore 10        ; 45 кадров (~0.75с) показ оценки
    gload 13
    push 1
    add
    gstore 13
    ; рекорд денег
    gload 3
    gload 15
    gt
    jz sg_no_best
    gload 3
    save K1
    gload 3
    gstore 15
    ret
sg_no_best:
    ret

; ================= следующий заказ =================
new_order:
    push 0
    gstore 5
    push 0
    gstore 0
    push 0
    gstore 1
    push 0
    gstore 2
    push 0
    gstore 14
    push 0
    gstore 9
    push 0
    gstore 10
    push 0
    gstore 12
    ; стакан 0..3
    push 4
    rand
    gstore 7
    ; цель 25..95
    push 71
    rand
    push 25
    add
    gstore 6
    beep 900 40
    ret

; ================= лицо: тик анимации =================
; g11 фаза лица:
;   0 idle, 1 blink, 2 pouring(глаза на пиво), 3 near(у цели: пот),
;   4 rage, 5 happy(perfect), 6 smile(good), 7 meh, 8 gameover
face_tick:
    gload 12
    push 1
    add
    gstore 12
    ; gameover -> всегда 8
    gload 5
    push 2
    eq
    jnz ft_go
    ; в poured: лицо по оценке
    gload 5
    jnz ft_grade
    ; serve: наливаем?
    gload 2
    jnz ft_pouring
    ; idle: моргание 3 кадра каждые 160
    gload 12
    push 160
    mod
    dup
    push 157
    ge
    jnz ft_blink
    drop
    push 0
    gstore 11
    ret
ft_blink:
    drop
    push 1
    gstore 11
    ret
ft_pouring:
    ; близко к цели (eff >= target-8) -> фаза 3 (пот+брови)
    gload 0
    gload 1
    push 4
    div
    add
    gload 6
    push 8
    sub
    ge
    jnz ft_near
    push 2
    gstore 11
    ret
ft_near:
    push 3
    gstore 11
    ret
ft_grade:
    gload 9
    push 1
    eq
    jnz ft_happy
    gload 9
    push 2
    eq
    jnz ft_smile
    gload 9
    push 3
    eq
    jnz ft_meh
    push 4
    gstore 11     ; spill -> rage
    ret
ft_happy:
    push 5
    gstore 11
    ret
ft_smile:
    push 6
    gstore 11
    ret
ft_meh:
    push 7
    gstore 11
    ret
ft_go:
    push 8
    gstore 11
    ret

; ================= отрисовка =================
draw:
    cls

    ; ---- ЖИВОЕ ЛИЦО (следит за пивом, реагирует на всё) ----
    call draw_face

    ; ---- кран: корпус + ручка по потоку ----
    call draw_tap

    ; ---- стакан (24x35 @ x=64 y=10) ----
    push 64
    push 10
    call draw_glass

    ; ---- ПИВО: fill -> высота (внутр. зона стакана y=12..42) ----
    gload 0
    push 0
    gt
    jnz dr_beer
    jmp dr_foam
dr_beer:
    gload 0
    push 30
    mul
    push 100
    div            ; h = fill*30/100
    push 42
    swap
    sub            ; y = 42 - h
    gstore 18      ; beerY
    push 68
    gload 18
    push 16
    gload 0
    push 30
    mul
    push 100
    div
    push 1
    frect
    ; волна-линии на пиве
    gload 18
    push 3
    add
    gstore 19
dr_wav:
    gload 19
    push 41
    lt
    jnz dr_wav_do
    jmp dr_foam
dr_wav_do:
    push 68
    gload 19
    push 16
    push 1
    push 0
    frect
    gload 19
    push 5
    add
    gstore 19
    jmp dr_wav

    ; пузырьки в пиве: поднимаются (2 фазы мигания), только когда пиво есть
dr_bubbles:
    gload 0
    push 5
    gt
    jnz dr_bub_do
    jmp dr_foam
dr_bub_do:
    msec
    push 250
    div
    push 2
    mod
    jnz dr_bub_a
    ; фаза A: два пузырька на разной высоте
    push 70
    gload 18
    push 4
    add
    push 1
    push 1
    push 0
    frect
    push 80
    gload 18
    push 8
    add
    push 1
    push 1
    push 0
    frect
    jmp dr_foam
dr_bub_a:
    ; фаза B: пузырьки выше (поднимаются)
    push 72
    gload 18
    push 2
    add
    push 1
    push 1
    push 0
    frect
    push 78
    gload 18
    push 5
    add
    push 1
    push 1
    push 0
    frect
    jmp dr_foam

dr_foam:
    ; пена: белая шапка над пивом
    gload 1
    push 0
    gt
    jnz dr_foam_do
    jmp dr_target
dr_foam_do:
    gload 1
    push 6
    mul
    push 100
    div            ; fh = foam*6/100 (макс 6px)
    gload 18
    push 2
    sub
    swap
    sub            ; y = beerY-2 - fh
    gstore 19
    push 68
    gload 19
    push 16
    gload 1
    push 6
    mul
    push 100
    div
    push 1
    frect
    ; пузыри пены (мигают)
    msec
    push 200
    div
    push 2
    mod
    jnz dr_foam_a
    push 68
    gload 19
    push 1
    sub
    push 2
    push 2
    push 1
    frect
    jmp dr_target
dr_foam_a:
    push 78
    gload 19
    push 1
    sub
    push 3
    push 2
    push 1
    frect
    jmp dr_target

dr_target:
    ; целевая отметка: стрелка-указатель слева + пунктир через стакан + число справа
    gload 6
    push 30
    mul
    push 100
    div
    push 42
    swap
    sub
    gstore 19      ; targetY
    ; стрелка слева от стакана: острие к стакану
    push 59
    gload 19
    push 2
    sub
    push 1
    push 1
    push 1
    frect
    push 60
    gload 19
    push 1
    sub
    push 1
    push 1
    push 1
    frect
    push 61
    gload 19
    push 1
    push 1
    push 1
    frect
    push 62
    gload 19
    push 3
    push 1
    push 1
    frect
    push 63
    gload 19
    push 3
    push 1
    push 1
    frect
    push 60
    gload 19
    push 1
    sub
    push 1
    push 2
    push 1
    frect
    push 60
    gload 19
    push 1
    add
    push 1
    push 2
    push 1
    frect
    ; пунктир через стакан (мигает медленно)
    msec
    push 400
    div
    push 2
    mod
    jnz dr_t_dash
    push 64
    gload 19
    push 3
    push 1
    push 1
    frect
    push 69
    gload 19
    push 3
    push 1
    push 1
    frect
    push 74
    gload 19
    push 3
    push 1
    push 1
    frect
    push 79
    gload 19
    push 3
    push 1
    push 1
    frect
    jmp dr_t_num
dr_t_dash:
    push 66
    gload 19
    push 2
    push 1
    push 1
    frect
    push 71
    gload 19
    push 2
    push 1
    push 1
    frect
    push 76
    gload 19
    push 2
    push 1
    push 1
    frect
    push 81
    gload 19
    push 2
    push 1
    push 1
    frect
    push 85
    gload 19
    push 2
    push 1
    push 1
    frect
dr_t_num:
    ; число цели справа от стакана (y на 4 выше линии)
    push 90
    gload 19
    push 4
    sub
    push 1
    gload 6
    num

    ; ---- СТРУЯ: от крана до пива/пены ----
    gload 2
    push 0
    gt
    jnz dr_jet
    jmp dr_hud
dr_jet:
    ; ширина по потоку: 1..4
    gload 2
    push 30
    div
    push 1
    max
    gstore 20      ; jetW
    ; колебание струи
    msec
    push 40
    div
    push 2
    mod
    gstore 21
    ; низ струи = верх пива (beerY) или дно стакана
    gload 0
    push 0
    gt
    jnz dr_jet_y
    push 42
    gstore 18
dr_jet_y:
    ; струя: от кончика носика (x=86..87, y=10) вниз до верха пива
    gload 18
    push 10
    sub
    push 1
    max
    gstore 22      ; jetH = beerY - 10
    ; ширина струи по потоку: 1..4 (g20), плюс дрожь x (g21)
    ; струя чуть СУЖАЕТСЯ к низу: рисуем 2 сегмента
    ; сегмент 1 (верх, от носика): x=86+g21, w=g20
    push 86
    gload 21
    add
    push 10
    gload 20
    gload 22
    push 2
    div
    push 1
    max
    push 1
    frect
    ; сегмент 2 (низ, к пиву): на 1px уже, чуть смещён
    gload 22
    push 2
    lt
    jnz dr_jet_done
    ; x2 = 86 + g21 (ОТДЕЛЬНОЕ значение)
    push 86
    gload 21
    add
    ; y2 = 10 + jetH/2
    push 10
    gload 22
    push 2
    div
    add
    ; w2 = jetW - 1 (мин 1)
    gload 20
    push 1
    sub
    push 1
    max
    ; h2 = jetH - jetH/2 (мин 1)
    gload 22
    gload 22
    push 2
    div
    sub
    push 1
    max
    ; c
    push 1
    frect
    ; брызги при сильном потоке: 2 точки разлета
    gload 2
    push 60
    ge
    jnz dr_jet_spray
    jmp dr_jet_done
dr_jet_spray:
    msec
    push 80
    div
    push 2
    mod
    jnz dr_jet_spray_a
    push 84
    push 12
    push 1
    push 1
    push 1
    frect
    push 90
    push 13
    push 1
    push 1
    push 1
    frect
    jmp dr_jet_done
dr_jet_spray_a:
    push 83
    push 14
    push 1
    push 1
    push 1
    frect
    push 91
    push 11
    push 1
    push 1
    push 1
    frect
dr_jet_done:
    jmp dr_hud

dr_hud:
    ; ---- деньги: TIP JAR справа сверху ----
    text 92 0 1 S2
    push 122
    push 0
    push 1
    gload 3
    num
    ; ---- порции: xN справа снизу от денег ----
    push 122
    push 8
    push 1
    gload 13
    num
    ; ---- таймер: секунды + полоска сверху слева ----
    gload 4
    push 60
    div
    gstore 22
    push 2
    push 2
    push 1
    gload 22
    num
    ; таймер-полоска: ширина = timeLeft/75 (3600/75 = 48 max), высота 1
    push 2
    push 6
    gload 4
    push 75
    div
    push 1
    push 1
    frect

    ; ---- статусные надписи ----
    gload 5
    jnz dr_state_poured
    ; serve: подсказка
    gload 2
    jnz dr_pouring_hint
    text 2 43 1 SB
    jmp dr_disp
dr_pouring_hint:
    text 52 43 1 S3
    jmp dr_disp

dr_state_poured:
    ; оценка: имя + $
    gload 9
    push 1
    eq
    jnz dr_gr_p
    gload 9
    push 2
    eq
    jnz dr_gr_g
    gload 9
    push 3
    eq
    jnz dr_gr_m
    jmp dr_gr_s
dr_gr_p:
    text 50 43 1 S4
    jmp dr_gr_usd
dr_gr_g:
    text 50 43 1 S5
    jmp dr_gr_usd
dr_gr_m:
    text 50 43 1 S6
    jmp dr_gr_usd
dr_gr_s:
    text 50 43 1 S8
    jmp dr_disp
dr_gr_usd:
    ; +$N анимация рядом с оценкой
    push 104
    push 43
    push 1
    gload 17
    num
    jmp dr_disp

dr_disp:
    ; (score compare) рекорд если больше
    gload 3
    gload 15
    gt
    jnz dr_newbest
    jmp dr_show
dr_newbest:
    text 2 43 1 S9
dr_show:
    disp
    ; gameover: держим экран
    gload 5
    push 2
    eq
    jnz dr_go_loop
    jmp main
dr_go_loop:
    jmp main

; ================= game over =================
game_over:
    push 2
    gstore 5
    ; рекорд
    gload 3
    gload 15
    gt
    jz go_no_best
    gload 3
    save K1
    gload 3
    gstore 15
    ret
go_no_best:
    ret

; ================= ЛИЦО (процедурное, следит за пивом) =================
; Кадр лица: голова-скруглённый прямоугольник + глаза с зрачками,
; зрачки смотрят на уровень пива (beerY), брови/рот по фазе g11.
draw_face:
    ; базовая позиция: x=6..42 (w=36), y=10..46 (h=36); rage-тряска
    push 0
    gstore 23      ; shakeX = 0
    gload 11
    push 4
    eq
    jnz df_rage_shake
    jmp df_base
df_rage_shake:
    msec
    push 50
    div
    push 3
    mod
    push 2
    sub
    gstore 23      ; shakeX = -1..1
df_base:
    ; голова: контур (rect x=6+shk, y=10, w=36, h=36)
    push 6
    gload 23
    add
    push 10
    push 36
    push 36
    push 1
    rect
    ; уши-пуха сверху: две дуги
    push 12
    gload 23
    add
    push 8
    push 1
    push 1
    circ
    push 36
    gload 23
    add
    push 8
    push 1
    push 1
    circ

    ; ---- глаза: позиция зрачков по фазе ----
    ; idle: зрачок в центре, смотрит на стакан (вправо-вниз слегка)
    ; pouring: зрачки едут ВНИЗ с уровнем пива: pupilY = 18 + fill*10/100
    ; near: + дрожь x
    ; blink: глаза закрыты (линии)
    ; rage: X-глаза
    ; happy: дуги ^^
    ; meh/go: точки
    gload 11
    jz df_eyes_idle
    gload 11
    push 1
    eq
    jnz df_eyes_blink
    gload 11
    push 2
    eq
    jnz df_eyes_pour
    gload 11
    push 3
    eq
    jnz df_eyes_pour
    gload 11
    push 4
    eq
    jnz df_eyes_rage
    gload 11
    push 5
    eq
    jnz df_eyes_happy
    gload 11
    push 6
    eq
    jnz df_eyes_happy
    jmp df_eyes_go   ; meh + gameover

df_eyes_idle:
    ; открытые глаза: белки 7x8, зрачки вправо-вниз (смотрит на стакан)
    ; левый глаз x=12..18, правый x=30..36, y=18..26
    push 12
    gload 23
    add
    push 18
    push 7
    push 8
    push 1
    rect
    push 30
    gload 23
    add
    push 18
    push 7
    push 8
    push 1
    rect
    ; зрачки: маленькие 2x3, чуть вправо-вниз
    push 16
    gload 23
    add
    push 21
    push 2
    push 3
    push 1
    frect
    push 34
    gload 23
    add
    push 21
    push 2
    push 3
    push 1
    frect
    jmp df_mouth

df_eyes_blink:
    ; закрытые: линии 7x1
    push 12
    gload 23
    add
    push 22
    push 7
    push 1
    push 1
    frect
    push 30
    gload 23
    add
    push 22
    push 7
    push 1
    push 1
    frect
    jmp df_mouth

df_eyes_pour:
    ; открытые глаза + зрачки следят за пивом: pupilY = 19 + fill*8/100
    push 12
    gload 23
    add
    push 18
    push 7
    push 9
    push 1
    rect
    push 30
    gload 23
    add
    push 18
    push 7
    push 9
    push 1
    rect
    ; дрожь зрачков при near-фазе
    gload 11
    push 3
    eq
    jnz df_pupil_shiver
    push 0
    gstore 24      ; jitter = 0
    jmp df_pupil_draw
df_pupil_shiver:
    msec
    push 30
    div
    push 3
    mod
    gstore 24      ; jitter 0..2
df_pupil_draw:
    ; pupilY = 19 + fill*8/100 (+ jitter по x)
    gload 0
    push 8
    mul
    push 100
    div
    push 19
    add
    gstore 25
    push 16
    gload 24
    add
    gload 23
    add
    gload 25
    push 2
    push 3
    push 1
    frect
    push 34
    gload 24
    add
    gload 23
    add
    gload 25
    push 2
    push 3
    push 1
    frect
    ; фаза 3 (у цели): БРОВИ вверх + ПОТ (капли у висков)
    gload 11
    push 3
    eq
    jnz df_sweat
    jmp df_mouth
df_sweat:
    ; брови: линии над глазами
    push 12
    gload 23
    add
    push 15
    push 7
    push 1
    push 1
    frect
    push 30
    gload 23
    add
    push 15
    push 7
    push 1
    push 1
    frect
    ; пот: капли (мигают) у висков
    msec
    push 100
    div
    push 2
    mod
    jnz df_sweat_a
    push 9
    gload 23
    add
    push 20
    push 1
    push 2
    push 1
    frect
    jmp df_mouth
df_sweat_a:
    push 42
    gload 23
    add
    push 24
    push 1
    push 2
    push 1
    frect
    jmp df_mouth

df_eyes_rage:
    ; X-глаза: кресты
    push 12
    gload 23
    add
    push 18
    push 2
    push 2
    push 1
    frect
    push 15
    gload 23
    add
    push 18
    push 2
    push 2
    push 1
    frect
    push 12
    gload 23
    add
    push 21
    push 7
    push 1
    push 1
    frect
    push 12
    gload 23
    add
    push 18
    push 7
    push 1
    push 1
    frect
    push 18
    gload 23
    add
    push 18
    push 1
    push 7
    push 1
    frect
    ; второй X
    push 30
    gload 23
    add
    push 18
    push 2
    push 2
    push 1
    frect
    push 33
    gload 23
    add
    push 18
    push 2
    push 2
    push 1
    frect
    push 30
    gload 23
    add
    push 21
    push 7
    push 1
    push 1
    frect
    push 30
    gload 23
    add
    push 18
    push 7
    push 1
    push 1
    frect
    push 36
    gload 23
    add
    push 18
    push 1
    push 7
    push 1
    frect
    jmp df_mouth

df_eyes_happy:
    ; дуги ^^: два уголка вверх
    push 12
    gload 23
    add
    push 22
    push 1
    push 1
    push 1
    frect
    push 13
    gload 23
    add
    push 21
    push 1
    push 1
    push 1
    frect
    push 14
    gload 23
    add
    push 20
    push 1
    push 1
    push 1
    frect
    push 15
    gload 23
    add
    push 20
    push 1
    push 1
    push 1
    frect
    push 16
    gload 23
    add
    push 21
    push 1
    push 1
    push 1
    frect
    push 17
    gload 23
    add
    push 22
    push 1
    push 1
    push 1
    frect
    ; правая дуга
    push 30
    gload 23
    add
    push 22
    push 1
    push 1
    push 1
    frect
    push 31
    gload 23
    add
    push 21
    push 1
    push 1
    push 1
    frect
    push 32
    gload 23
    add
    push 20
    push 1
    push 1
    push 1
    frect
    push 33
    gload 23
    add
    push 20
    push 1
    push 1
    push 1
    frect
    push 34
    gload 23
    add
    push 21
    push 1
    push 1
    push 1
    frect
    push 35
    gload 23
    add
    push 22
    push 1
    push 1
    push 1
    frect
    jmp df_mouth

df_eyes_go:
    ; meh/gameover: точки 2x2
    push 15
    gload 23
    add
    push 21
    push 2
    push 2
    push 1
    frect
    push 33
    gload 23
    add
    push 21
    push 2
    push 2
    push 1
    frect
    jmp df_mouth

df_mouth:
    ; ---- рот по фазе ----
    gload 11
    push 4
    eq
    jnz df_m_rage
    gload 11
    push 5
    eq
    jnz df_m_happy
    gload 11
    push 6
    eq
    jnz df_m_happy
    gload 11
    push 8
    eq
    jnz df_m_go
    ; idle/pour/blink/near/meh: нейтральная линия 12x1
    push 18
    gload 23
    add
    push 34
    push 12
    push 1
    push 1
    frect
    ret
df_m_rage:
    ; открытый ОВАЛ-крик (компактный): r=5
    push 21
    gload 23
    add
    push 34
    push 5
    push 1
    fcirc
    push 23
    gload 23
    add
    push 36
    push 2
    push 1
    push 1
    frect
    ret
df_m_happy:
    ; улыбка: дуга вверх по краям
    push 17
    gload 23
    add
