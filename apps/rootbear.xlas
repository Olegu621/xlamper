; ==================================================================
; ROOT BEAR — порт Playdate-игры FOF "Root Bear" для C3 XLAMPER
; Спрайты медведей и кружки взяты из оригинального .pdx (1:1 стиль).
;
; МЕХАНИКА НАЛИВА (аналоговая!):
;   Стик вниз  = наклон кувшина: чем ниже, тем СИЛЬНЕЕ поток
;     лёгкий наклон  -> тонкая струя, точный контроль
;     полное отклонение -> мощный поток, риск перелива
;   Пиво поднимается, пена растёт (пена = быстрее при сильном потоке)
;   Перелив через край = провал заказа
;   Клик = подать кружку медведю -> оценка по точности
;   Удержание клика = выход
;
; Оценки: PERFECT (+3), GOOD (+1), MEH (0), RAGE (-1, пролил)
; Рекорд в NVS. Каждый заказ: целевая линия случайная.
; ==================================================================
.title ROOTBEAR
.data 40
; g0=fill    уровень пива 0..100
; g1=foam    пена 0..100 (нельзя подавать пока пена > 20 — осядет)
; g2=flow    текущий поток 0..100 (от стика)
; g3=score
; g4=best
; g5=state   0=order,1=pour,2=grade,3=spill
; g6=target  целевой уровень 30..85
; g7=streak
; g8=t       таймер анимации
; g9=client  0..5 (какой медведь)
; g10=blinkT таймер моргания
; g11=tipX   X струи (постоянна)
; g12=wob    фаза колебания струи
; g13=foamRate накопление пены

.str S1 ROOT BEAR
.str S2 ORDER:
.str S3 POUR!
.str S4 PERFECT!
.str S5 GOOD
.str S6 MEH
.str S7 RAGE!
.str S8 SPILL!
.str S9 SC
.str SA BEST
.str SB SERVE
.str SC HOLD STICK DOWN TO POUR
.str SD CLICK=SERVE HOLD=EXIT
.str K1 best

; ================= init =================
start:
    push 0
    gstore 0
    push 0
    gstore 1
    push 0
    gstore 2
    push 0
    gstore 3
    push 0
    gstore 7
    load K1 0
    gstore 4
    call new_order

; ================= main loop =================
main:
    frame
    msec
    gstore 8

    ; ---- события ----
    event
    dup
    push 6
    eq
    jnz ev_exit
    dup
    push 5
    eq
    jnz ev_click
    drop
    jmp physics

ev_exit:
    drop
    exit

ev_click:
    drop
    gload 5
    jnz st_click_next
    jmp st_click_pour
st_click_next:
    gload 5
    push 1
    sub
    jz st_serve        ; state==1: подать кружку
    ; state 2 (оценка) / 3 (spill): СЛЕДУЮЩИЙ ЗАКАЗ
    call new_order
    jmp physics
st_serve:
    call grade_serve
    jmp physics
st_click_pour:
    push 1
    gstore 5
    push 0
    gstore 0
    push 0
    gstore 1
    push 0
    gstore 13
    beep 900 50
    jmp physics

; ================= physics: аналоговый налив =================
physics:
    gload 5
    push 1
    eq
    jnz pour_active
    jmp blink_tick

pour_active:
    ; АНАЛОГ: sty 2048(центр)..4095(вниз) -> поток 0..100
    sty
    push 2300
    sub              ; 0..1795 (мёртвая зона до 2300)
    dup
    push 0
    lt
    jnz flow_zero
    ; масштаб: 1795 -> 100
    push 18
    div              ; 0..99
    dup
    push 0
    gt
    jnz flow_ok
    drop
    push 0
flow_ok:
    gstore 2
    jmp flow_apply
flow_zero:
    drop             ; съесть остаток v (dup-копию съел lt)
    push 0
    gstore 2
flow_apply:

    ; налив: fill += flow/12 за кадр
    gload 2
    push 12
    div
    gload 0
    add
    push 100
    min
    gstore 0

    ; пена:泡沫 растёт от потока (сильный поток = пена быстро)
    gload 2
    push 7
    div              ; flow/7
    gload 13
    add
    gstore 13
    gload 13
    push 3
    ge
    jnz foam_grow
    jmp foam_settle
foam_grow:
    push 0
    gstore 13
    gload 1
    push 1
    add
    push 100
    min
    gstore 1
    jmp foam_settle
foam_settle:
    ; пена ОСЕДАЕТ сама когда НЕ льём
    gload 2
    push 0
    eq
    jnz foam_down
    jmp spill_chk
foam_down:
    gload 1
    push 0
    gt
    jnz foam_dec
    jmp spill_chk
foam_dec:
    gload 1
    push 1
    sub
    gstore 1
    jmp spill_chk

spill_chk:
    ; ПЕРЕЛИВ: fill+foam > 100 -> SPILL
    gload 0
    gload 1
    add
    push 100
    gt
    jnz do_spill
    jmp blink_tick

do_spill:
    push 3
    gstore 5
    push 0
    gstore 2
    beep 150 300
    beep 100 300
    gload 7
    push 0
    gstore 7
    gload 3
    push 1
    sub
    gstore 3
    jmp blink_tick

; ---- моргание idle-медведя ----
blink_tick:
    gload 5
    jnz blink_skip
    msec
    push 2500
    mod
    push 2200
    ge
    jnz blink_on
    push 0
    gstore 10
    jmp blink_skip
blink_on:
    push 1
    gstore 10
blink_skip:
    jmp draw
grade_serve:
    ; нельзя подать с большой пеной? Пена входит в оценку: eff = fill + foam/3
    ; |fill + foam/3 - target| :
    gload 0
    gload 1
    push 3
    div
    add
    gload 6
    sub
    ; abs
    dup
    push 0
    lt
    jnz gs_neg
    jmp gs_pos
gs_neg:
    push -1
    mul
gs_pos:
    gstore 11        ; diff

    ; diff <= 5 -> PERFECT
    gload 11
    push 5
    le
    jnz gs_perfect
    ; diff <= 15 -> GOOD
    gload 11
    push 15
    le
    jnz gs_good
    ; diff <= 30 -> MEH
    gload 11
    push 30
    le
    jnz gs_meh
    jmp gs_rage

gs_perfect:
    push 2
    gstore 5
    push 4
    gstore 9
    gload 3
    push 3
    add
    gstore 3
    gload 7
    push 1
    add
    gstore 7
    beep 1600 80
    beep 1900 120
    jmp gs_show
gs_good:
    push 2
    gstore 5
    push 3
    gstore 9
    gload 3
    push 1
    add
    gstore 3
    gload 7
    push 1
    add
    gstore 7
    beep 1200 80
    jmp gs_show
gs_meh:
    push 2
    gstore 5
    push 5
    gstore 9
    gload 7
    push 0
    gstore 7
    beep 600 150
    jmp gs_show
gs_rage:
    push 2
    gstore 5
    push 6
    gstore 9
    push 0
    gstore 7
    gload 3
    push 1
    sub
    gstore 3
    beep 200 200
    beep 150 250
gs_show:
    ; рекорд
    gload 3
    gload 4
    gt
    jnz gs_best
    ret
gs_best:
    gload 3
    save K1
    gload 3
    gstore 4
    ret

; ================= новый заказ =================
new_order:
    push 0
    gstore 5
    push 0
    gstore 2
    push 0
    gstore 0
    push 0
    gstore 1
    push 0
    gstore 9        ; idle медведь
    push 0
    gstore 10
    push 1
    gstore 11
    ; цель 30..85
    push 56
    rand
    push 30
    add
    gstore 6
    ret

; ================= draw =================
draw:
    cls

    ; ---- медведь слева (по состоянию) ----
    gload 5
    push 2
    eq
    jnz dr_grade_bear
    gload 5
    push 3
    eq
    jnz dr_rage_bear
    ; order/pour: idle или blink
    gload 10
    jnz dr_blink
    call draw_bear_idle
    jmp dr_bear_done
dr_blink:
    call draw_bear_blink
    jmp dr_bear_done
dr_grade_bear:
    gload 9
    push 4
    eq
    jnz dr_perfect_b
    gload 9
    push 3
    eq
    jnz dr_good_b
    gload 9
    push 5
    eq
    jnz dr_meh_b
    jmp dr_rage_bear
dr_perfect_b:
    call draw_bear_perfect
    jmp dr_bear_done
dr_good_b:
    call draw_bear_good
    jmp dr_bear_done
dr_meh_b:
    call draw_bear_meh
    jmp dr_bear_done
dr_rage_bear:
    call draw_bear_rage
dr_bear_done:

    ; ---- кружка (x=98..124, y=4..42) ----
    call draw_glass

    ; ---- ПИВО: заливка внутри кружки ----
    ; внутренняя зона: x=101..121, y=6..40. Полная высота пива: 34px при fill=100
    gload 0
    push 0
    gt
    jnz beer_draw
    jmp foam_draw
beer_draw:
    ; h = fill * 34 / 100
    gload 0
    push 34
    mul
    push 100
    div
    gstore 11
    gload 11
    push 1
    max
    gstore 11
    ; y = 40 - h
    push 40
    gload 11
    sub
    gstore 12
    ; ЗАЛИВКА С ГОРИЗОНТАЛЬНЫМИ ПУЗЫРЯМИ (тёмные линии-«волны»):
    push 101
    gload 12
    push 21
    gload 11
    push 1
    frect
    ; волны: каждые 6px тёмная линия 1px (эффект пива)
    gload 12
    push 5
    add
    gstore 11
beer_waves:
    gload 11
    push 39
    lt
    jnz beer_wave_do
    jmp foam_draw
beer_wave_do:
    push 101
    gload 11
    push 21
    push 1
    push 0
    frect
    gload 11
    push 6
    add
    gstore 11
    jmp beer_waves

    ; ---- ПЕНА: белая шапка над пивом (мигает-колышется) ----
foam_draw:
    gload 1
    push 0
    gt
    jnz foam_do
    jmp target_line
foam_do:
    ; foam пикс: fh = foam*10/100 (макс 10)
    gload 1
    push 10
    mul
    push 100
    div
    gstore 11
    ; верх пива = ybeer_top
    gload 0
    push 34
    mul
    push 100
    div
    push 40
    sub
    push 6
    max
    gstore 12
    ; пена: белые «пузыри» — блобы над пивом с jitter
    msec
    push 300
    div
    push 2
    mod
    gstore 11
    push 101
    gload 12
    gload 11
    sub
    push 3
    push 2
    push 1
    frect
    push 106
    gload 12
    gload 11
    sub
    push 1
    push 4
    push 1
    frect
    push 110
    gload 12
    gload 11
    sub
    push 2
    push 3
    push 1
    frect
    push 115
    gload 12
    gload 11
    sub
    push 2
    push 2
    push 1
    frect
    push 119
    gload 12
    gload 11
    sub
    push 4
    push 2
    push 1
    frect

    ; ---- ЦЕЛЕВАЯ ЛИНИЯ (тире) ----
target_line:
    gload 5
    push 1
    eq
    jnz tl_draw
    jmp score_draw
tl_draw:
    ; y = 40 - target*34/100
    gload 6
    push 34
    mul
    push 100
    div
    push 40
    sub
    push 6
    max
    gstore 12
    push 98
    gload 12
    push 27
    push 1
    push 0
    frect

    ; ---- СТРУЯ (поток) ----
    gload 2
    push 0
    gt
    jnz jet_draw
    jmp score_draw
jet_draw:
    ; струя от кувшина (y=0) до пива: x центр = 111, ширина = flow/25
    ; колебание: wob = msec/40 % 2
    msec
    push 40
    div
    push 2
    mod
    gstore 11
    gload 2
    push 25
    div
    push 1
    max
    gstore 12
    ; y низа струи = верх пива (ybeer)
    gload 0
    push 34
    mul
    push 100
    div
    push 40
    sub
    push 6
    max
    gstore 13
    push 111
    gload 11
    add
    push 0
    gload 12
    gload 13
    push 1
    frect

    ; ---- счёт ----
score_draw:
    text 2 0 1 S9
    push 14
    push 0
    push 1
    gload 3
    num
    text 76 0 1 SA
    push 104
    push 0
    push 1
    gload 4
    num

    ; ---- подписи по состоянию ----
    gload 5
    jz st_order
    push 1
    gload 5
    sub
    jz st_pour
    push 2
    gload 5
    sub
    jz st_grade
    jmp st_spill

st_order:
    text 40 43 1 S2
    ; target число справа от линии
    push 2
    push 12
    push 1
    gload 6
    num
    jmp dd
st_pour:
    ; процент стика: flow
    push 2
    push 43
    push 1
    gload 2
    num
    ; streak >= 2: STREAK x N
    gload 7
    push 2
    ge
    jnz streak_show
    jmp dd
streak_show:
    text 40 43 1 S4
    jmp dd
st_grade:
    ; оценка по client
    gload 9
    push 4
    eq
    jnz gr_perf
    gload 9
    push 3
    eq
    jnz gr_good
    gload 9
    push 5
    eq
    jnz gr_meh
    jmp gr_rage
gr_perf:
    text 40 43 1 S4
    jmp dd
gr_good:
    text 40 43 1 S5
    jmp dd
gr_meh:
    text 40 43 1 S6
    jmp dd
gr_rage:
    text 40 43 1 S7
    jmp dd
st_spill:
    text 40 43 1 S8
dd:
    disp
    jmp main

