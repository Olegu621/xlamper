df_m_go:
    ; gameover: скорбный рот (дуга вниз) + слеза
    push 18
    gload 23
    add
    push 35
    push 12
    push 1
    push 1
    frect
    push 17
    gload 23
    add
    push 36
    push 1
    push 1
    push 1
    frect
    push 29
    gload 23
    add
    push 36
    push 1
    push 1
    push 1
    frect
    ; слеза (мигает)
    msec
    push 200
    div
    push 2
    mod
    jnz df_m_go_ret
    push 14
    gload 23
    add
    push 27
    push 1
    push 3
    push 1
    frect
df_m_go_ret:
    ret

; ================= КРАН (процедурный) =================
; ================= КРАН (красивый механизм) =================
; Композиция (x 62..88, y 0..10):
;   [БАК-корпус] сверху: корпус 14x5 с крышкой и заклёпками
;   [ТРУБА] вниз 4x2
;   [НОСИК] изогнутый: горизонталь 6px + сужение
;   [РЫЧАГ] слева: ось + ручка, угол зависит от потока (0=вверх, 100=вниз)
;   при flow>0: из носика капли + подсветка носика мигает
draw_tap:
    ; ---- БАК: корпус x=66..80, y=0..4 (frect 14x4) ----
    push 66
    push 0
    push 14
    push 4
    push 1
    frect
    ; крышка-полоска сверху (двойной контур)
    push 65
    push 0
    push 16
    push 1
    push 1
    frect
    ; заклёпки: 2 точки внутри бака
    push 68
    push 2
    push 1
    push 1
    push 0
    frect
    push 77
    push 2
    push 1
    push 1
    push 0
    frect

    ; ---- ТРУБА: x=71..74, y=4..6 ----
    push 71
    push 4
    push 4
    push 2
    push 1
    frect

    ; ---- НОСИК: колено x=71..87, y=6..8 + сужение-кончик x=85..88 y=7..9 ----
    push 71
    push 6
    push 14
    push 2
    push 1
    frect
    push 83
    push 8
    push 4
    push 1
    push 1
    frect
    push 86
    push 9
    push 2
    push 1
    push 1
    frect
    ; кончик носика (тёмное отверстие когда закрыт / мигает когда открыт)
    gload 2
    push 0
    gt
    jnz dt_tip_open
    push 87
    push 9
    push 1
    push 1
    push 0
    frect
    jmp dt_lever
dt_tip_open:
    msec
    push 100
    div
    push 2
    mod
    jnz dt_tip_a
    push 87
    push 9
    push 1
    push 1
    push 1
    frect
    jmp dt_lever
dt_tip_a:
    push 86
    push 9
    push 2
    push 1
    push 1
    frect

    ; ---- РЫЧАГ слева: ось (x=69,y=7) + ручка, угол по потоку ----
    ; flow 0..100 -> ручка длина 6: от (69,1) до (69+cos, 1+sin)
    ; упрощённо: 3 позиции ручки
dt_lever:
    ; ось-болт
    push 69
    push 7
    push 2
    push 2
    push 1
    frect
    gload 2
    push 0
    gt
    jnz dt_lv2
    ; закрыт: ручка ВВЕРХ (вертикально)
    push 69
    push 1
    push 2
    push 6
    push 1
    frect
    ret
dt_lv2:
    ; открыт: ручка дрожит вниз (угол по потоку: слабый=45°, сильный=90°)
    ; сильный поток: ручка вниз до y=7
    gload 2
    push 50
    ge
    jnz dt_lv3
    ; слабый: 45° — ступенька (2px вправо-вниз)
    push 71
    push 5
    push 2
    push 2
    push 1
    frect
    push 69
    push 3
    push 2
    push 2
    push 1
    frect
    ret
dt_lv3:
    ; сильный: ручка вертикально вниз + дрожит
    msec
    push 60
    div
    push 2
    mod
    jnz dt_lv4
    push 69
    push 1
    push 2
    push 6
    push 1
    frect
    ret
dt_lv4:
    push 69
    push 2
    push 2
    push 5
    push 1
    frect
    ret
