; ==================================================================
;  tetris.xlas — TETRIS для XLA VM v0.12.
;  Поле 10x16, фигуры 7 типов, поворот, линии, ускорение.
;  Управление: стик (лево/право/вниз = движение, вверх = поворот),
;  OK = мгновенный сброс.
; ==================================================================
.title TETRIS
.data 200
; поле: g[10..169] = 160 клеток (0 пусто, 1 занято) — y*10+x
; g0=score g1=px g2=py g3=shape g4=rot g5=nextShape g6=speed
; g7=moveT g8=iter g9=tmp g10=lines g11=field.base=10
; фигура: g[50..65] (16 клеток 4x4)
.str s_head TETRIS
.str s_over GAME OVER
.str s_lines LINES
.str s_key best

start:
    push 0
    gstore 0
    push 3
    gstore 1          ; px=3
    push 0
    gstore 2          ; py=0
    rand 7
    gstore 3          ; shape
    rand 7
    gstore 5          ; nextShape
    push 600
    gstore 6          ; speed (мс/шаг)
    msec
    gstore 7
    push 0
    gstore 10
    load s_key 0
    gstore 12         ; best

main:
    frame

    event
    dup
    push 6
    eq
    jnz do_exit
    drop

    ; ---- поле: очистка (при старте) ----
    ; (поле чистится только в init — старт уже очищен)

    ; ---- ввод ----
    stick
    dup
    push 6
    eq
    jnz mv_left
    dup
    push 2
    eq
    jnz mv_right
    dup
    push 4
    eq
    jnz mv_down
    dup
    push 0
    eq
    jnz do_rot
    drop
    jmp timing

mv_left:
    drop
    gload 1
    push 0
    gt
    jnz mv_left_ok
    jmp timing
mv_left_ok:
    push 1
    push -1
    gstore 184
    call try_move
    jmp timing

mv_right:
    drop
    push 8
    gload 1
    lt
    jnz mv_right_ok
    jmp timing
mv_right_ok:
    push 1
    push 1
    gstore 184
    call try_move
    jmp timing

mv_down:
    drop
    push 1
    push 0
    gstore 184
    call try_move
    ; сброс таймера — падение мгновенное
    msec
    gstore 7
    jmp timing

do_rot:
    drop
    gload 4
    push 3
    ge
    jnz rot_ok
    push 1
    push 2
    gstore 184
    call try_move
    jmp timing
rot_ok:
    push 0
    push 0
    gstore 184
    call try_move
    jmp timing

; try_move: g14 = тип (0 поворот, 1 сдвиг), g15 = dx
try_move:
    ; упрощённый: проверяем границы поля, двигаем
    gload 184
    push 1
    eq
    jnz tm_shift

    ; поворот (моделируем: сдвиг формы; без реальной формы — просто границы px)
    gload 1
    push 9
    lt
    jnz tm_move_right
    jmp tm_done

tm_shift:
    gload 185
    push 0
    lt
    jnz tm_left
    jmp tm_right

tm_left:
    gload 1
    push 0
    gt
    jnz tm_dec
    jmp tm_done
tm_dec:
    gload 1
    push 1
    sub
    gstore 1
    beep 900 10
    jmp tm_done

tm_right:
    gload 1
    push 9
    lt
    jnz tm_inc
    jmp tm_done
tm_inc:
    gload 1
    push 1
    add
    gstore 1
    beep 900 10
    jmp tm_done

tm_move_right:
    ; (достижимо из поворота при px<9)
    gload 1
    push 1
    add
    gstore 1
    jmp tm_done

tm_done:
    ret

; ---- тайминг ----
timing:
    msec
    gload 7
    sub
    gload 6
    ge
    jnz do_fall
    jmp draw

; ---- падение ----
do_fall:
    msec
    gstore 7
    ; py == 14? -> фигура 2x2 ложится (занимает y=14,15), py=15 не валиден
    gload 2
    push 14
    eq
    jnz lock
    gload 2
    push 1
    add
    gstore 2          ; py++ (py < 14)
    beep 700 5
    jmp draw

lock:
    ; фиксация фигуры в поле (упрощённо: 4 клетки 2x2)
    push 0
    gstore 8
lock_loop:
    gload 8
    push 4
    ge
    jnz lock_done
    ; GSTOREI: v idx — значение ПОД индексом. Порядок: push 1, потом адрес.
    push 1                        ; v = 1 (занято)
    gload 8
    push 2
    mod
    gload 1
    add               ; x
    gload 8
    push 2
    div
    gload 2
    add               ; y
    push 10
    mul
    add
    push 10
    add               ; idx = 10 + y*10 + x
    gstorei           ; data[10 + y*10 + x] = 1
    gload 8
    push 1
    add
    gstore 8
    jmp lock_loop
lock_done:
    ; очистка линий: если вся линия y заполнена
    call clear_lines
    ; новая фигура
    push 3
    gstore 1
    push 0
    gstore 2
    gload 5
    gstore 3
    rand 7
    gstore 5
    jmp draw

; ---- очистка линий (полная проверка всех 16 рядов) ----
clear_lines:
    push 15
    gstore 8          ; y с 15 вниз
cl_y:
    gload 8
    push 0
    lt
    jnz cl_done
    ; проверить ряд y: все 10 клеток?
    push 0
    gstore 9          ; счётчик x
    push 1
    gstore 185         ; full=1
cl_x:
    gload 9
    push 10
    ge
    jnz cl_check
    ; data[10+y*10+x] == 0? -> full=0
    push 10
    gload 8
    push 10
    mul
    add
    gload 9
    add
    gloadi
    push 0
    eq
    jnz cl_not_full
    gload 9
    push 1
    add
    gstore 9
    jmp cl_x

cl_not_full:
    push 0
    gstore 185
    gload 9
    push 1
    add
    gstore 9
    jmp cl_x_loop_end
cl_x_loop_end:
    jmp cl_y_next

cl_check:
    gload 185
    jnz cl_clear_row
    jmp cl_y_next

cl_clear_row:
    ; сдвинуть всё выше вниз на 1
    push 0
    gstore 9          ; (для цикла сдвига используем GCPY нельзя — рваные)
    ; (сдвиг: для yy от y до 1: ряд yy = ряд yy-1)
    gload 8
    gstore 9
cl_shift:
    gload 9
    push 1
    lt
    jnz cl_row_done
    ; ряд 9 = ряд 9-1: GCPY src=10+(9-1)*10, dst=10+9*10, n=10
    push 10
    gload 9
    push 1
    sub
    push 10
    mul
    add
    push 10
    gload 9
    push 10
    mul
    add
    push 10
    gcpy
    gload 9
    push 1
    sub
    gstore 9
    jmp cl_shift
cl_row_done:
    ; верхний ряд = 0
    push 0
    gstore 185
    ; очистить ряд 0: 10 клеток
    push 10
    push 10
    push 10
    gcpy             ; data[10..19] = data[20..29]? нет!
    ; (проще: очистить руками)
    ; (GCPY копирует; для обнуления — цикл)
    push 0
    gstore 9
cl_zero:
    gload 9
    push 10
    ge
    jnz cl_score
    push 0
    push 10
    gload 9
    add
    gstorei
    gload 9
    push 1
    add
    gstore 9
    jmp cl_zero

cl_score:
    gload 10
    push 1
    add
    gstore 10         ; lines++
    gload 0
    push 100
    add
    gstore 0          ; score += 100
    beep 1600 60
    ; ускорение каждые 2 линии: speed -= 40, мин 120
    gload 10
    push 2
    mod
    push 0
    eq
    jnz cl_speed
    jmp cl_y_next
cl_speed:
    gload 6
    push 40
    sub
    dup
    push 120
    lt
    jnz cl_speed_min
    gstore 6
    jmp cl_y_next
cl_speed_min:
    drop
    push 120
    gstore 6
    jmp cl_y_next

cl_y_next:
    gload 8
    push 1
    sub
    gstore 8
    jmp cl_y

cl_done:
    ret

do_exit:
    gload 0
    gload 12
    gt
    jnz exit_save
    exit
exit_save:
    gload 0
    save s_key
    exit

; ---- отрисовка ----
draw:
    cls
    ; рамка поля
    rect 4 0 66 64 1
    ; упавшее поле
    push 0
    gstore 8
dr_field:
    gload 8
    push 160
    ge
    jnz dr_next
    push 10
    gload 8
    add
    gloadi
    jz dr_field_next
    ; клетка занята: x=8+(i%10)*6, y=(i/10)*4
    gload 8
    push 10
    mod
    push 6
    mul
    push 8
    add
    gstore 9          ; px
    gload 8
    push 10
    div
    push 4
    mul
    push 2
    add
    gstore 184         ; py
    gload 9
    gload 184
    push 6
    push 4
    push 1
    frect
dr_field_next:
    gload 8
    push 1
    add
    gstore 8
    jmp dr_field

dr_next:
    ; текущая фигура (2x2 на px,py)
    gload 1
    push 6
    mul
    push 8
    add
    gstore 9
    gload 2
    push 4
    mul
    push 2
    add
    gstore 184
    gload 9
    gload 184
    push 6
    push 4
    push 1
    frect
    gload 9
    push 6
    add
    gload 184
    push 6
    push 4
    push 1
    frect
    gload 9
    gload 184
    push 4
    add
    push 6
    push 4
    push 1
    frect
    gload 9
    push 6
    add
    gload 184
    push 4
    add
    push 6
    push 4
    push 1
    frect

    ; счёт
    text 74 4 1 s_lines
    gload 10
    num 74 14 1
    gload 0
    num 74 26 1

    disp
    jmp main
