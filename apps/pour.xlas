; ==================================================================
; POUR — прототип Root Bear для C3 XLAMPER (XLA VM v1)
; Медведь-бармен. Стик ←→ = наклон кувшина (скорость налива),
; клик = наливать / подать кружку. Оценка: PERFECT/GOOD/BAD.
; Одна инструкция на строку. Стек: push x y w h c -> RECT.
; ==================================================================
.title POUR
.data 12
; g0=fill(0..100) g1=foam g2=tilt g3=score g4=best
; g5=state(0 idle,1 pour,2 grade) g6=animT g7=rate g8=h g9=g11 g10=g12 вспом.

.str T1 POUR
.str T2 PERFECT!
.str T3 GOOD
.str T4 BAD...
.str T5 click=pour
.str TH hold=exit
.str K1 best

; ================= init =================
start:
    push 0
    gstore 0
    push 0
    gstore 1
    push 0
    gstore 2
    push 0
    gstore 3
    push 0
    gstore 5
    load K1 0
    gstore 4

; ================= main loop =================
main_loop:
    frame

    ; ---- stick -> tilt ----
    stick
    dup
    push 2
    eq
    jnz tilt_r
    dup
    push 6
    eq
    jnz tilt_l
    drop
    push 0
    gstore 2
    jmp tilt_done
tilt_r:
    drop
    push 1
    gstore 2
    jmp tilt_done
tilt_l:
    drop
    push -1
    gstore 2
tilt_done:

    ; ---- events ----
    event
    dup
    push 6
    eq
    jnz ev_exit
    dup
    push 5
    eq
    jnz ev_click
    drop
    jmp physics

ev_exit:
    drop
    exit

ev_click:
    drop
    gload 5
    jz a_start
    gload 5
    push 1
    eq
    jnz a_grade
    ; state==2 -> reset
    push 0
    gstore 5
    push 0
    gstore 0
    push 0
    gstore 1
    jmp physics

a_start:
    push 1
    gstore 5
    push 0
    gstore 0
    push 0
    gstore 1
    beep 900 80
    jmp physics

a_grade:
    gload 0
    push 85
    ge
    jz grade_good
    push 2
    gstore 5
    gload 3
    push 3
    add
    gstore 3
    gload 3
    gload 4
    gt
    jz gp_nb
    gload 3
    gstore 4
    gload 4
    save K1
gp_nb:
    beep 1600 120
    jmp physics
grade_good:
    gload 0
    push 50
    ge
    jz grade_bad
    push 2
    gstore 5
    gload 3
    push 1
    add
    gstore 3
    beep 1100 100
    jmp physics
grade_bad:
    push 2
    gstore 5
    beep 220 300

; ================= physics =================
physics:
    gload 5
    push 1
    eq
    jnz pouring
    msec
    push 200
    mod
    gstore 6
    jmp draw_scene
pouring:
    gload 2
    jnz rate_fast
    push 2
    gstore 7
    jmp do_pour
rate_fast:
    push 5
    gstore 7
do_pour:
    gload 0
    gload 7
    add
    dup
    push 100
    gt
    jz cap_f
    drop
    push 100
cap_f:
    gstore 0
    gload 1
    gload 7
    add
    dup
    push 100
    gt
    jz cap_fm
    drop
    push 100
cap_fm:
    gstore 1
    msec
    push 100
    mod
    gstore 6

; ================= draw =================
draw_scene:
    cls

    ; ---- mug: rect 22 42 24 16 ----
    push 22
    push 42
    push 24
    push 16
    push 1
    rect
    ; handle
    push 46
    push 45
    push 4
    push 8
    push 0
    rect
    push 47
    push 44
    push 3
    push 10
    push 1
    rect
    push 46
    push 46
    push 2
    push 6
    push 0
    rect
    ; ---- beer fill ----
    gload 0
    push 14
    mul
    push 100
    div
    gstore 8
    gload 8
    push 1
    lt
    jz beer_ok
    push 1
    gstore 8
beer_ok:
    push 56
    gload 8
    sub
    gstore 9
    push 0
    gstore 10
brows_loop:
    gload 10
    gload 8
    lt
    jz brows_done
    push 55
    gload 10
    sub
    gstore 11
    push 24
    gload 11
    push 20
    push 1
    push 1
    rect
    gload 10
    push 1
    add
    gstore 10
    jmp brows_loop
brows_done:

    ; ---- foam (animated) ----
    gload 1
    jz no_foam
    gload 1
    push 10
    gt
    jz foam_small
    msec
    push 100
    mod
    push 2
    mod
    jz foam_a
    push 26
    push 40
    push 2
    push 2
    push 1
    ell
    push 34
    push 40
    push 2
    push 2
    push 1
    ell
    push 42
    push 40
    push 2
    push 2
    push 1
    ell
    jmp no_foam
foam_small:
    push 26
    push 41
    push 2
    push 1
    push 1
    ell
    push 34
    push 41
    push 2
    push 1
    push 1
    ell
    push 42
    push 41
    push 2
    push 1
    push 1
    ell
    jmp no_foam
foam_a:
    push 28
    push 39
    push 2
    push 2
    push 1
    ell
    push 36
    push 39
    push 2
    push 2
    push 1
    ell
    push 44
    push 39
    push 2
    push 2
    push 1
    ell
no_foam:

    ; ---- bear head ----
    push 98
    push 22
    push 9
    push 1
    fcirc
    push 90
    push 15
    push 3
    push 1
    fcirc
    push 106
    push 15
    push 3
    push 1
    fcirc
    ; eyes (blink ~200ms каждые 2.4s)
    msec
    push 2400
    mod
    push 200
    lt
    jnz eyes_shut
    push 94
    push 20
    push 1
    push 1
    fcirc
    push 102
    push 20
    push 1
    push 1
    fcirc
    jmp snout
eyes_shut:
    push 93
    push 20
    push 95
    push 20
    push 1
    line
    push 101
    push 20
    push 103
    push 20
    push 1
    line
snout:
    push 98
    push 25
    push 3
    push 1
    fcirc
    push 97
    push 24
    push 0
    px
    push 99
    push 24
    push 0
    px
    ; smile
    push 95
    push 29
    push 1
    px
    push 96
    push 30
    push 1
    px
    push 97
    push 31
    push 1
    px
    push 98
    push 31
    push 1
    px
    push 99
    push 31
    push 1
    px
    push 100
    push 30
    push 1
    px
    push 101
    push 29
    push 1
    px
    ; body
    push 98
    push 44
    push 9
    push 12
    push 1
    ell
    push 98
    push 46
    push 5
    push 7
    push 0
    ell

    ; ---- arm + jug (tilt) ----
    gload 2
    jz jug_flat
    gload 2
    push 0
    gt
    jnz jug_hi
    ; jug left (низко)
    push 90
    push 38
    push 84
    push 34
    push 1
    line
    push 84
    push 34
    push 82
    push 34
    push 1
    line
    push 82
    push 34
    push 82
    push 40
    push 1
    line
    push 82
    push 40
    push 86
    push 40
    push 1
    line
    push 86
    push 40
    push 86
    push 34
    push 1
    line
    jmp bear_done
jug_hi:
    ; jug right (высоко)
    push 90
    push 38
    push 94
    push 32
    push 1
    line
    push 94
    push 32
    push 96
    push 30
    push 1
    line
    push 96
    push 30
    push 96
    push 24
    push 1
    line
    push 96
    push 24
    push 100
    push 24
    push 1
    line
    push 100
    push 24
    push 100
    push 30
    push 1
    line
    jmp bear_done
jug_flat:
    push 90
    push 38
    push 86
    push 34
    push 1
    line
    push 86
    push 34
    push 82
    push 34
    push 1
    line
    push 82
    push 34
    push 82
    push 40
    push 1
    line
    push 82
    push 40
    push 86
    push 40
    push 1
    line
    push 86
    push 40
    push 86
    push 34
    push 1
    line
bear_done:

    ; ---- stream (pouring only) ----
    gload 5
    push 1
    eq
    jnz draw_stream
    jmp grade_chk
draw_stream:
    gload 6
    push 2
    mod
    jz st_a
    push 60
    push 36
    push 1
    px
    push 58
    push 38
    push 1
    px
    push 55
    push 40
    push 1
    px
    jmp grade_chk
st_a:
    push 61
    push 36
    push 1
    px
    push 59
    push 38
    push 1
    px
    push 56
    push 40
    push 1
    px

grade_chk:
    gload 5
    push 2
    eq
    jnz show_grade
    jmp hud
show_grade:
    push 0
    fill
    push 14
    push 12
    push 100
    push 40
    push 1
    rect
    text 24 16 1 T1
    gload 0
    push 85
    ge
    jz gr_g
    text 40 30 1 T2
    jmp gr_sc
gr_g:
    gload 0
    push 50
    ge
    jz gr_b
    text 40 30 1 T3
    jmp gr_sc
gr_b:
    text 40 30 1 T4
gr_sc:
    text 24 42 1 T5
    jmp finish_frame

hud:
    text 4 55 1 T5
    text 66 55 1 TH
    text 24 16 1 T1

finish_frame:
    disp
    jmp main_loop
