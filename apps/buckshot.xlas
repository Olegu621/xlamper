.title Buckshot
.data 16

.str S_I "I:"
.str S_B "B:"
.str S_PATR "Patr:"
.str S_SLASH "/"
.str S_ARROW "->"
.str S_SELF "SELF"
.str S_ENEMY "ENEMY"
.str S_WIN "YOU WIN!"
.str S_LOSE "YOU LOSE"
.str S_DRAW "DRAW"

start:
    push 4
    push 0
    gstorei
    push 4
    push 1
    gstorei

    msec
    rand
    push 5
    mod
    push 2
    add
    push 2
    gstorei

    push 2
    gloadi
    push 2
    div
    push 1
    add
    push 2
    gloadi
    min
    push 5
    gstorei

    push 0
fill_loop:
    push 5
    gloadi
    push 0
    gt
    jz fill_blanks
    push 1
    push 10
    push 0
    gloadi
    add
    gstorei
    push 5
    gloadi
    push 1
    sub
    push 5
    gstorei
    jmp fill_next
fill_blanks:
    push 0
    push 10
    push 0
    gloadi
    add
    gstorei
fill_next:
    push 0
    gloadi
    push 1
    add
    push 0
    gstorei
    push 0
    gloadi
    push 2
    gloadi
    lt
    jnz fill_loop

    push 2
    gloadi
    push 1
    sub
    push 5
    gstorei
shuffle_loop:
    push 5
    gloadi
    push 0
    le
    jnz shuffle_done
    msec
    rand
    push 5
    gloadi
    push 1
    add
    mod
    push 0
    gstorei
    push 10
    push 5
    gloadi
    add
    gloadi
    push 6
    gstorei
    push 10
    push 0
    gloadi
    add
    gloadi
    push 10
    push 5
    gloadi
    add
    gstorei
    push 6
    gloadi
    push 10
    push 0
    gloadi
    add
    gstorei
    push 5
    gloadi
    push 1
    sub
    push 5
    gstorei
    jmp shuffle_loop
shuffle_done:

    push 0
    push 3
    gstorei
    push 0
    push 4
    gstorei

main_loop:
    cls

    text 5 0 1 S_I
    push 0
    gloadi
    push 20
    push 0
    push 1
    num
    text 40 0 1 S_B
    push 1
    gloadi
    push 55
    push 0
    push 1
    num

    text 5 15 1 S_PATR
    push 2
    gloadi
    push 45
    push 15
    push 1
    num

    push 0
    push 5
    gstorei
    push 3
    gloadi
    push 0
    gstorei
count_loop:
    push 0
    gloadi
    push 2
    gloadi
    lt
    jz count_done
    push 10
    push 0
    gloadi
    add
    gloadi
    push 1
    eq
    jz count_next
    push 5
    gloadi
    push 1
    add
    push 5
    gstorei
count_next:
    push 0
    gloadi
    push 1
    add
    push 0
    gstorei
    jmp count_loop
count_done:
    push 5
    gloadi
    push 65
    push 15
    push 1
    num
    text 75 15 1 S_SLASH
    push 2
    gloadi
    push 3
    gloadi
    sub
    push 5
    gloadi
    sub
    push 85
    push 15
    push 1
    num

    text 20 35 1 S_ARROW
    push 4
    gloadi
    push 0
    eq
    jz show_enemy
    text 35 35 1 S_SELF
    jmp show_choice_done
show_enemy:
    text 35 35 1 S_ENEMY
show_choice_done:

    stick
    dup
    push -1
    eq
    jnz no_input
    dup
    push 6
    eq
    jz check_right
    push 0
    push 4
    gstorei
    jmp no_input
check_right:
    dup
    push 2
    eq
    jz check_ok
    push 1
    push 4
    gstorei
    jmp no_input
check_ok:
    dup
    push 5
    eq
    jz check_exit
    jmp do_shot
check_exit:
    dup
    push 6
    eq
    jnz do_exit
no_input:
    push 100
    delay
    jmp main_loop

do_shot:
    push 3
    gloadi
    push 2
    gloadi
    lt
    jz out_of_ammo

    push 10
    push 3
    gloadi
    add
    gloadi
    push 6
    gstorei
    push 3
    gloadi
    push 1
    add
    push 3
    gstorei

    push 6
    gloadi
    push 1
    eq
    jz blank_shot

    push 4
    gloadi
    push 0
    eq
    jz shoot_bot
    push 0
    gloadi
    push 1
    sub
    push 0
    gstorei
    push 150
    push 200
    beep
    jmp after_shot
shoot_bot:
    push 1
    gloadi
    push 1
    sub
    push 1
    gstorei
    push 200
    push 200
    beep
    jmp after_shot

blank_shot:
    push 100
    push 100
    beep

after_shot:
    push 0
    gloadi
    push 0
    le
    jnz game_over
    push 1
    gloadi
    push 0
    le
    jnz game_over

    push 3
    gloadi
    push 2
    gloadi
    lt
    jz out_of_ammo

    push 0
    push 5
    gstorei
    push 3
    gloadi
    push 0
    gstorei
bot_count_loop:
    push 0
    gloadi
    push 2
    gloadi
    lt
    jz bot_count_done
    push 10
    push 0
    gloadi
    add
    gloadi
    push 1
    eq
    jz bot_count_next
    push 5
    gloadi
    push 1
    add
    push 5
    gstorei
bot_count_next:
    push 0
    gloadi
    push 1
    add
    push 0
    gstorei
    jmp bot_count_loop
bot_count_done:
    push 2
    gloadi
    push 3
    gloadi
    sub
    push 5
    gloadi
    sub
    push 0
    gstorei
    push 5
    gloadi
    push 0
    gloadi
    gt
    jz bot_shoot_self

    push 10
    push 3
    gloadi
    add
    gloadi
    push 6
    gstorei
    push 3
    gloadi
    push 1
    add
    push 3
    gstorei
    push 6
    gloadi
    push 1
    eq
    jz bot_blank
    push 0
    gloadi
    push 1
    sub
    push 0
    gstorei
    push 150
    push 200
    beep
    jmp bot_after_shot
bot_blank:
    push 100
    push 100
    beep
    jmp bot_after_shot

bot_shoot_self:
    push 10
    push 3
    gloadi
    add
    gloadi
    push 6
    gstorei
    push 3
    gloadi
    push 1
    add
    push 3
    gstorei
    push 6
    gloadi
    push 1
    eq
    jz bot_self_blank
    push 1
    gloadi
    push 1
    sub
    push 1
    gstorei
    push 200
    push 200
    beep
    jmp bot_after_shot
bot_self_blank:
    push 100
    push 100
    beep

bot_after_shot:
    push 0
    gloadi
    push 0
    le
    jnz game_over
    push 1
    gloadi
    push 0
    le
    jnz game_over
    push 3
    gloadi
    push 2
    gloadi
    lt
    jz out_of_ammo
    jmp main_loop

out_of_ammo:
    push 0
    gloadi
    push 1
    gloadi
    gt
    jz out_draw_or_lose
    cls
    text 30 20 1 S_WIN
    jmp game_over_wait
out_draw_or_lose:
    push 0
    gloadi
    push 1
    gloadi
    eq
    jz out_lose
    text 40 20 1 S_DRAW
    jmp game_over_wait
out_lose:
    text 30 20 1 S_LOSE
    jmp game_over_wait

game_over:
    cls
    push 0
    gloadi
    push 0
    le
    jz bot_died
    text 30 20 1 S_LOSE
    jmp game_over_wait
bot_died:
    text 30 20 1 S_WIN

game_over_wait:
    stick
    push 5
    eq
    jz game_over_wait

do_exit:
    exit
