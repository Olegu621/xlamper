; ==================================================================
;  snake.xlas — SNAKE для XLA VM v0.12.
;  Механика соответствует облачному snake (Olegu621/xlamper):
;   * поле 42x15 клеток по 3px; клетка = 42*y+x (один int16);
;   * тело в g[100..199], длина до 100;
;   * антиразворот, ускорение с каждой едой, рекорд в NVS;
;   * GCPY сдвигает тело.
;  Управление: стик 8-way (0=вверх 2=вправо 4=вниз 6=влево), OK — рестарт.
; ==================================================================
.title SNAKE
.data 200
.str s_head SNAKE
.str s_sc SC
.str s_best BEST
.str s_over GAME OVER
.str s_best_key best

; ---- глобалы ----
; g0=len g1=dir g2=moveT g3=score g4=alive g5=foodX g6=foodY
; g7=iter g8=tmpA g9=tmpB g11=best g12=prevDir g13=delayMs
; g100..199 = тело (клетки)

start:
    ; init
    push 3
    gstore 0          ; len=3
    push 1
    gstore 1          ; dir=вправо
    push 0
    gstore 3          ; score=0
    push 1
    gstore 4          ; alive=1
    push 260
    gstore 13         ; delayMs=260
    push 1
    gstore 12         ; prevDir=вправо (синхронно с dir!)
    load s_best_key 0
    gstore 11         ; best = LOAD("best", 0)

    ; тело: (5,7)(4,7)(3,7) -> клетки 299, 175, 51
    push 299
    gstore 100
    push 175
    gstore 101
    push 51
    gstore 102

    call place_food

main:
    frame

    ; ---- выход ----
    event
    dup
    push 6
    eq
    jnz die_save      ; EXIT -> сохранение рекорда и... нет, EXIT = выход
    drop

    ; ---- рестарт по OK если мертвы ----
    event
    dup
    push 5
    eq
    gload 4
    push 0
    eq
    and
    jnz restart
    drop
    ; (выше два event — второй event не нужен, но паттерн снимет)

    ; ---- ввод направления (только если живы) ----
    gload 4
    jz timing          ; мертвы — пропускаем ввод

    stick
    dup
    push 0
    eq
    jnz in_up
    dup
    push 2
    eq
    jnz in_right
    dup
    push 4
    eq
    jnz in_down
    dup
    push 6
    eq
    jnz in_left
    drop
    jmp timing

in_up:
    drop               ; снять stick-значение
    gload 1
    push 2
    eq                 ; dir == вниз?
    jnz timing         ; антиразворот: игнор
    push 0
    gstore 12
    jmp timing
in_right:
    drop
    gload 1
    push 6
    eq
    jnz timing
    push 1
    gstore 12
    jmp timing
in_down:
    drop
    gload 1
    push 0
    eq
    jnz timing
    push 2
    gstore 12
    jmp timing
in_left:
    drop
    gload 1
    push 2
    eq
    jnz timing
    push 3
    gstore 12
    jmp timing

; ---- тайминг шага ----
timing:
    gload 4
    jz draw           ; мертвы — только рисуем

    msec
    gload 2
    sub
    gload 13
    ge
    jnz step
    jmp draw

; ---- шаг ----
step:
    gload 12
    gstore 1          ; dir = prevDir
    msec
    gstore 2          ; moveT = now

    ; новая голова: g8=hx, g9=hy из клетки g[100]
    gload 100
    push 42
    div
    gstore 9          ; hy = cell/42
    gload 100
    push 42
    mod
    gstore 8          ; hx = cell%42

    gload 1
    push 0
    eq
    jnz mv_up
    gload 1
    push 1
    eq
    jnz mv_right
    gload 1
    push 2
    eq
    jnz mv_down
    jmp mv_left

mv_up:
    gload 9
    push 1
    sub
    gstore 9
    jmp head_chk
mv_right:
    gload 8
    push 1
    add
    gstore 8
    jmp head_chk
mv_down:
    gload 9
    push 1
    add
    gstore 9
    jmp head_chk
mv_left:
    gload 8
    push 1
    sub
    gstore 8
    jmp head_chk

head_chk:
    ; стены
    gload 8
    push 0
    lt
    jnz die
    gload 8
    push 42
    ge
    jnz die
    gload 9
    push 0
    lt
    jnz die
    gload 9
    push 15
    ge
    jnz die

    ; новая клетка головы
    gload 9
    push 42
    mul
    gload 8
    add
    gstore 7          ; iter = новая клетка

    ; самопересечение: сравнить со всеми сегментами
    push 0
    gstore 8          ; hx -> счётчик цикла (переиспользуем)
self_loop:
    gload 8
    gload 0
    ge
    jnz self_ok       ; прошли все — ок
    ; тело[i] = data[100+i]: адрес — константа 100 + счётчик
    push 100
    gload 8
    add
    gloadi
    gload 7
    eq
    jnz die          ; голова == сегмент -> смерть
    gload 8
    push 1
    add
    gstore 8
    jmp self_loop

self_ok:
    ; GCPY: тело сдвигается на 1 (dst=101, src=100, n=len-1)
    push 100
    push 101
    gload 0
    push 1
    sub
    gcpy

    ; новая голова
    gload 7
    gstore 100

    ; еда? (голова-клетка g7 == foodY*42+foodX)
    gload 7
    gload 6
    push 42
    mul
    gload 5
    add
    eq
    jnz eat

    jmp draw

eat:
    gload 0
    push 1
    add
    gstore 0          ; len++
    gload 3
    push 1
    add
    gstore 3          ; score++
    beep 1400 40
    ; ускорение: delayMs -= 12, минимум 20
    gload 13
    push 12
    sub
    dup
    push 20
    lt
    jnz eat_min
    gstore 13
    jmp eat_food
eat_min:
    drop
    push 20
    gstore 13
eat_food:
    call place_food
    jmp draw

die:
    push 0
    gstore 4          ; alive=0
    beep 200 400
    ; сохранить рекорд
    gload 3
    gload 11
    gt
    jnz die_save
    jmp draw

die_save:
    gload 3
    save s_best_key
    gload 3
    gstore 11
    jmp draw

restart:
    drop
    drop               ; снять event-остатки
    push 3
    gstore 0
    push 1
    gstore 1
    push 0
    gstore 3
    push 1
    gstore 4
    push 260
    gstore 13
    push 1
    gstore 12         ; prevDir=вправо (синхронно с dir!)
    push 299
    gstore 100
    push 175
    gstore 101
    push 51
    gstore 102
    call place_food
    jmp main

; ---- размещение еды ----
place_food:
    push 42
    rand
    gstore 5          ; foodX
    push 15
    rand
    gstore 6          ; foodY
    ; проверка: не на теле (только голова + 3 сегмента — упрощённо полный цикл)
    push 0
    gstore 8
pf_loop:
    gload 8
    gload 0
    ge
    jnz pf_done
    ; тело[i] = data[100+i]: адрес — константа 100 + счётчик
    push 100
    gload 8
    add
    gloadi
    gload 5
    gload 6
    push 42
    mul
    add
    eq
    jnz place_food    ; на теле — заново
    gload 8
    push 1
    add
    gstore 8
    jmp pf_loop
pf_done:
    ret

; ---- отрисовка ----
draw:
    cls

    ; рамка поля
    rect 0 0 128 48 1

    ; мигающая еда
    msec
    push 400
    mod
    push 200
    lt
    jnz draw_food
    jmp draw_body
draw_food:
    ; пиксели еды через глобалы (без стековой акробатики)
    gload 5
    push 3
    mul
    push 1
    add
    gstore 8          ; fx = foodX*3+1
    gload 6
    push 3
    mul
    push 1
    add
    gstore 9          ; fy = foodY*3+1
    gload 8
    gload 9
    push 2
    push 2
    push 1
    frect             ; x y w h c — ассемблер кладёт как пишется
    jmp draw_body

draw_body:
    push 0
    gstore 8
db_loop:
    gload 8
    gload 0
    ge
    jnz draw_ui
    ; клетка тела[i] = data[100+i] (адрес — константа 100 + счётчик)
    push 100
    gload 8
    add
    gloadi
    push 42
    mod
    push 3
    mul
    push 1
    add
    gstore 7          ; px = cell%42*3+1
    push 100
    gload 8
    add
    gloadi
    push 42
    div
    push 3
    mul
    push 1
    add
    gstore 9          ; py = cell/42*3+1
    gload 7
    gload 9
    push 2
    push 2
    push 1
    frect
    gload 8
    push 1
    add
    gstore 8
    jmp db_loop

draw_ui:
    ; SC score
    text 2 52 1 s_sc
    gload 3
    num 16 52 1
    ; BEST best
    text 40 52 1 s_best
    gload 11
    num 76 52 1
    ; GAME OVER
    gload 4
    jz disp
    text 34 24 1 s_over

disp:
    disp
    jmp main
